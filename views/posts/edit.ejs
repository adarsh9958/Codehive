<% layout("./boilerplate/boilerplate") %>

<!-- Include Bootstrap CSS (if not already) -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>

<div class="container mt-5">
  <div class="bg-custom-dark">
    <h2 class="mb-4 text-light">Edit Post</h2>
    <form
      action="/posts/<%= post._id %>?_method=PUT"
      method="post"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label for="postTitle" class="form-label text-light">Title</label>
        <input
          type="text"
          name="post[title]"
          class="form-control bg-secondary"
          id="postTitle"
          placeholder="Enter your title"
          value="<%= post.title %>"
          required
        />
        <div class="invalid-feedback">Title is required.</div>
      </div>

      <div class="mb-3">
        <label for="postContent" class="form-label text-light">Content</label>
        <textarea
          name="post[content]"
          class="form-control bg-secondary"
          id="postContent"
          placeholder="Enter your content"
          rows="6"
          required
        >
<%= post.content %></textarea
        >
        <div class="invalid-feedback">Content is required.</div>
      </div>

      <div class="mb-3">
        <label for="postCode" class="form-label text-light">Code</label>
        <textarea
          name="post[code]"
          class="form-control bg-secondary"
          id="postCode"
          placeholder="Enter your code"
          rows="6"
          required
        >
<%= post.code %></textarea
        >
        <div class="invalid-feedback">Please provide your code snippets</div>
      </div>

      <button type="submit" class="btn btn-success">Update Post</button>
    </form>
  </div>
</div>

<!-- Custom slightly-dark theme style -->
<style>
  .bg-custom-dark {
    background-color: #3a3b3c;
    color: #fff;
    border-radius: 0.5rem;
    padding: 2rem;
  }
</style>
